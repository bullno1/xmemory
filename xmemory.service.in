[Unit]
Description=Save and restore X11 window positions
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=DISPLAY
# X11 sessions only: Under Wayland, DISPLAY points to XWayland
ConditionEnvironment=!WAYLAND_DISPLAY

[Service]
ExecStart=@BINDIR@/xmemory
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
